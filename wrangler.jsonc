{
	"name": "portfolio",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-06-19",
	// no_handle_cross_request_promise_resolution: Next.js shares promises across requests when it
	// regenerates cached (ISR) pages, and under that runtime rule the later request can never settle
	// them, so about one request in four failed with a 500. Remove it once OpenNext has its own
	// incremental cache and queue (R2 / D1 / Durable Objects), which keep that work per request
	"compatibility_flags": ["nodejs_compat", "no_handle_cross_request_promise_resolution"],
	"d1_databases": [
		{
			"binding": "CHAT_DB",
			"database_name": "portfolio-chat",
			"database_id": "a70cee93-8120-4c3d-b996-49f5992127c2",
			"migrations_dir": "migrations"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1,
		},
	},
}
